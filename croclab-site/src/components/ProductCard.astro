---
import type { Product } from '../data/products';
import type { Lang } from '../i18n/translations';
import { useTranslation, getLocalizedPath } from '../i18n/translations';

interface Props {
  product: Product;
  lang: Lang;
  index: number;
  /** 首页产品区 pin 滚动逐张Reveal */
  pinReveal?: boolean;
}

const { product, lang, index, pinReveal = false } = Astro.props;
const t = useTranslation(lang);
const tagline = lang === 'zh' ? product.taglineZh : product.tagline;
const description = lang === 'zh' ? product.descriptionZh : product.description;
---

<a
  href={getLocalizedPath(`/${product.id}`, lang)}
  class:list={[
    'group card-glow tilt-card p-6 lg:p-8 flex flex-col product-card',
    pinReveal ? 'product-card-pin' : 'animate-on-scroll',
  ]}
  style={`--stagger: ${index}; --product-color: ${product.color}`}
>
  <div class="flex items-start justify-between mb-5">
    <img src={product.icon} alt={product.name} class="w-14 h-14 rounded-2xl shadow-sm transition-transform duration-300 group-hover:scale-110" width="56" height="56" loading="lazy" />
    <div class="flex gap-1.5">
      {product.comingSoon && (
        <span class="px-2.5 py-1 text-[10px] font-semibold rounded-md text-white" style={`background: ${product.color}`}>
          {lang === 'zh' ? '即将上线' : 'Coming Soon'}
        </span>
      )}
      {product.platforms.ios && (
        <span class="px-2 py-1 text-[10px] font-medium rounded-md bg-[var(--color-bg-tertiary)] text-[var(--color-text-muted)]">iOS</span>
      )}
      {product.platforms.android && (
        <span class="px-2 py-1 text-[10px] font-medium rounded-md bg-[var(--color-bg-tertiary)] text-[var(--color-text-muted)]">Android</span>
      )}
      {product.platforms.chrome && (
        <span class="px-2 py-1 text-[10px] font-medium rounded-md bg-[var(--color-bg-tertiary)] text-[var(--color-text-muted)]">Chrome</span>
      )}
    </div>
  </div>

  <h3 class="font-display text-xl font-bold text-[var(--color-text)] mb-1 group-hover:text-[var(--color-accent)] transition-colors">
    {product.name}
  </h3>
  <p class="text-sm font-medium mb-3" style={`color: ${product.color}`}>{tagline}</p>
  <p class="text-sm text-[var(--color-text-muted)] leading-relaxed flex-1">{description}</p>

  <div class="mt-6 flex items-center text-sm font-semibold text-[var(--color-text-secondary)] group-hover:text-[var(--color-accent)] transition-colors">
    {t('products.learnMore')}
    <svg class="w-4 h-4 ml-1 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
    </svg>
  </div>

  <!-- Product color accent line at bottom -->
  <div class="absolute bottom-0 left-0 right-0 h-1 rounded-b-2xl opacity-0 group-hover:opacity-100 transition-opacity duration-300" style={`background: ${product.color}`}></div>
</a>

<style>
  .product-card {
    position: relative;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: 1rem;
    overflow: hidden;
    transition: all 0.3s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .product-card:hover {
    border-color: var(--color-border-light);
    box-shadow:
      0 20px 60px -15px var(--color-card-shadow),
      0 4px 20px -5px var(--color-card-shadow),
      0 0 0 1px var(--product-color, var(--color-accent))20;
  }
</style>
