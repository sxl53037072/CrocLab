---
import type { Lang } from '../i18n/translations';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const text = {
  en: {
    signIn: 'Sign In',
    signOut: 'Sign Out',
    profile: 'Profile',
    wishwall: 'Wish Wall',
    favorites: 'Favorites',
  },
  zh: {
    signIn: '登录',
    signOut: '退出',
    profile: '个人中心',
    wishwall: '需求墙',
    favorites: '收藏',
  },
};

const t = text[lang];
const profilePath = lang === 'zh' ? '/zh/profile/' : '/profile/';
const wishwallPath = lang === 'zh' ? '/zh/wishwall/' : '/wishwall/';
---

<div class="relative" id="auth-container">
  <!-- Signed out state -->
  <button
    id="sign-in-btn"
    class="hidden px-3.5 py-1.5 text-sm font-medium text-white bg-[var(--color-text)] rounded-lg hover:opacity-90 transition-all duration-200 items-center gap-2"
  >
    <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
      <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 01-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z" fill="#4285F4"/>
      <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
      <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/>
      <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
    </svg>
    {t.signIn}
  </button>

  <!-- Signed in state -->
  <div id="user-menu-wrapper" class="hidden relative">
    <button
      id="user-menu-btn"
      class="flex items-center gap-2 p-1 rounded-full hover:bg-[var(--color-bg-tertiary)] transition-colors"
    >
      <img
        id="user-avatar"
        src=""
        alt="Avatar"
        class="w-8 h-8 rounded-full border border-[var(--color-border)] object-cover"
      />
    </button>

    <!-- Dropdown -->
    <div
      id="user-dropdown"
      class="hidden absolute right-0 top-full mt-2 w-48 bg-[var(--color-bg)] border border-[var(--color-border)] rounded-xl shadow-lg shadow-black/10 overflow-hidden z-50"
    >
      <div id="user-info" class="px-4 py-3 border-b border-[var(--color-border)]">
        <p id="user-name" class="text-sm font-semibold text-[var(--color-text)] truncate"></p>
        <p id="user-email" class="text-xs text-[var(--color-text-muted)] truncate"></p>
      </div>
      <div class="py-1">
        <a href={profilePath} class="block px-4 py-2.5 text-sm text-[var(--color-text-secondary)] hover:bg-[var(--color-bg-tertiary)] transition-colors">
          {t.profile}
        </a>
        <a href={wishwallPath} class="block px-4 py-2.5 text-sm text-[var(--color-text-secondary)] hover:bg-[var(--color-bg-tertiary)] transition-colors">
          {t.wishwall}
        </a>
        <button
          id="sign-out-btn"
          class="w-full text-left px-4 py-2.5 text-sm text-red-500 hover:bg-[rgba(239,68,68,0.1)] transition-colors"
        >
          {t.signOut}
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  import { createClient } from '@supabase/supabase-js';

  const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL;
  const supabaseAnonKey = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;
  const supabase = createClient(supabaseUrl, supabaseAnonKey);

  const signInBtn = document.getElementById('sign-in-btn') as HTMLButtonElement;
  const userMenuWrapper = document.getElementById('user-menu-wrapper');
  const userMenuBtn = document.getElementById('user-menu-btn');
  const userDropdown = document.getElementById('user-dropdown');
  const userAvatar = document.getElementById('user-avatar') as HTMLImageElement;
  const userName = document.getElementById('user-name');
  const userEmail = document.getElementById('user-email');
  const signOutBtn = document.getElementById('sign-out-btn');

  function showSignedIn(user: any) {
    signInBtn?.classList.add('hidden');
    signInBtn?.classList.remove('inline-flex');
    userMenuWrapper?.classList.remove('hidden');
    if (userAvatar) {
      userAvatar.src = user.user_metadata?.avatar_url || user.user_metadata?.picture || '';
    }
    if (userName) userName.textContent = user.user_metadata?.full_name || user.user_metadata?.name || 'User';
    if (userEmail) userEmail.textContent = user.email || '';
  }

  function showSignedOut() {
    signInBtn?.classList.remove('hidden');
    signInBtn?.classList.add('inline-flex');
    userMenuWrapper?.classList.add('hidden');
  }

  async function init() {
    const { data: { session } } = await supabase.auth.getSession();
    if (session?.user) {
      showSignedIn(session.user);
      await ensureProfile(session.user);
    } else {
      showSignedOut();
    }

    supabase.auth.onAuthStateChange((_event, session) => {
      if (session?.user) {
        showSignedIn(session.user);
      } else {
        showSignedOut();
      }
    });
  }

  async function ensureProfile(user: any) {
    const { data } = await supabase.from('profiles').select('id').eq('id', user.id).single();
    if (!data) {
      await supabase.from('profiles').insert({
        id: user.id,
        display_name: user.user_metadata?.full_name || user.user_metadata?.name || null,
        avatar_url: user.user_metadata?.avatar_url || user.user_metadata?.picture || null,
      });
    }
  }

  signInBtn?.addEventListener('click', async () => {
    await supabase.auth.signInWithOAuth({
      provider: 'google',
      options: {
        redirectTo: `${window.location.origin}/auth/callback/`,
      },
    });
  });

  signOutBtn?.addEventListener('click', async () => {
    await supabase.auth.signOut();
    showSignedOut();
    userDropdown?.classList.add('hidden');
  });

  userMenuBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    userDropdown?.classList.toggle('hidden');
  });

  document.addEventListener('click', () => {
    userDropdown?.classList.add('hidden');
  });

  init();
</script>
