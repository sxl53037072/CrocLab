---
import BaseLayout from '../layouts/BaseLayout.astro';
import type { Lang } from '../i18n/translations';

const lang: Lang = 'en';
---

<BaseLayout
  title="Wish Wall — CrocLab"
  description="Tell us what app you wish existed. Vote on community ideas — the more people want it, the bigger it grows!"
  lang={lang}
>
  <section class="pt-28 pb-24">
    <div class="mx-auto max-w-5xl px-6 lg:px-8">
      <!-- Header -->
      <div class="text-center mb-12 animate-on-scroll">
        <p class="text-sm font-semibold uppercase tracking-widest text-purple-600 mb-3">Community</p>
        <h1 class="font-display text-3xl sm:text-4xl font-bold text-[var(--color-text)] mb-4">Wish Wall</h1>
        <p class="mx-auto max-w-2xl text-[var(--color-text-secondary)]">
          What app do you wish CrocLab would build? Give it a short name (1–3 words) and describe what it should do. Same ideas get merged — the more votes, the bigger it grows!
        </p>
      </div>

      <!-- Submit form -->
      <div id="wish-form-section" class="mb-14">
        <div id="wish-login-prompt" class="hidden text-center py-8 card p-6">
          <p class="text-[var(--color-text-secondary)] mb-4">Sign in to submit your app idea</p>
          <button id="wish-login-btn" class="btn-primary">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
              <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 01-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z" fill="#4285F4"/>
              <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
              <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/>
              <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
            </svg>
            Sign in with Google
          </button>
        </div>

        <div id="wish-submit-form" class="hidden">
          <div class="card p-6">
            <div class="flex flex-col sm:flex-row gap-3">
              <input
                type="text"
                id="wish-name"
                placeholder="App name (1–3 words)"
                maxlength="30"
                class="sm:w-48 px-4 py-3 text-sm border border-[var(--color-border)] rounded-xl bg-[var(--color-bg)] text-[var(--color-text)] focus:outline-none focus:border-[var(--color-accent)] focus:ring-2 focus:ring-[var(--color-accent)]/10 transition-all"
              />
              <input
                type="text"
                id="wish-desc"
                placeholder="Describe what it should do..."
                maxlength="500"
                class="flex-1 px-4 py-3 text-sm border border-[var(--color-border)] rounded-xl bg-[var(--color-bg)] text-[var(--color-text)] focus:outline-none focus:border-[var(--color-accent)] focus:ring-2 focus:ring-[var(--color-accent)]/10 transition-all"
              />
              <button id="wish-submit-btn" class="btn-primary shrink-0">Submit</button>
            </div>
            <div class="flex items-center justify-between mt-2">
              <p id="wish-error" class="hidden text-sm text-red-500"></p>
              <p id="wish-remaining" class="text-xs text-[var(--color-text-muted)] ml-auto">3 wishes remaining</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Wish Wall -->
      <div id="wish-loading" class="text-center py-16">
        <div class="inline-block w-8 h-8 border-2 border-[var(--color-border)] border-t-[var(--color-text)] rounded-full animate-spin"></div>
      </div>

      <div id="wish-empty" class="hidden text-center py-16">
        <div class="w-16 h-16 rounded-2xl bg-[rgba(147,51,234,0.1)] flex items-center justify-center mx-auto mb-4">
          <svg class="w-8 h-8 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
          </svg>
        </div>
        <p class="text-[var(--color-text-secondary)]">No wishes yet. Be the first to share your idea!</p>
      </div>

      <div id="wish-wall" class="hidden flex flex-wrap items-center justify-center gap-3 py-8"></div>

      <!-- Detail modal -->
      <div id="wish-modal" class="hidden fixed inset-0 z-[200] flex items-center justify-center p-4">
        <div id="wish-modal-backdrop" class="absolute inset-0 bg-black/40 backdrop-blur-sm"></div>
        <div class="relative bg-[var(--color-bg)] rounded-2xl border border-[var(--color-border)] shadow-2xl w-full max-w-lg max-h-[80vh] flex flex-col">
          <div class="flex items-center justify-between p-6 border-b border-[var(--color-border)]">
            <div>
              <h3 id="modal-title" class="font-display text-xl font-bold text-[var(--color-text)]"></h3>
              <p id="modal-stats" class="text-sm text-[var(--color-text-muted)] mt-1"></p>
            </div>
            <button id="modal-close" class="p-2 rounded-lg hover:bg-[var(--color-bg-tertiary)] transition-colors">
              <svg class="w-5 h-5 text-[var(--color-text-muted)]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
              </svg>
            </button>
          </div>
          <div id="modal-body" class="p-6 overflow-y-auto flex-1 space-y-4"></div>
          <div class="p-4 border-t border-[var(--color-border)] flex justify-end">
            <button id="modal-vote-btn" class="btn-primary text-sm">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 15l7-7 7 7" />
              </svg>
              <span id="modal-vote-text">Vote</span>
            </button>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import { createClient } from '@supabase/supabase-js';

  const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL;
  const supabaseAnonKey = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;
  const supabase = createClient(supabaseUrl, supabaseAnonKey);

  const MAX_WISHES = 3;

  const loginPrompt = document.getElementById('wish-login-prompt');
  const submitForm = document.getElementById('wish-submit-form');
  const loginBtn = document.getElementById('wish-login-btn');
  const nameInput = document.getElementById('wish-name') as HTMLInputElement;
  const descInput = document.getElementById('wish-desc') as HTMLInputElement;
  const submitBtn = document.getElementById('wish-submit-btn');
  const wishError = document.getElementById('wish-error');
  const wishRemaining = document.getElementById('wish-remaining');
  const wishLoading = document.getElementById('wish-loading');
  const wishEmpty = document.getElementById('wish-empty');
  const wishWall = document.getElementById('wish-wall');

  const modal = document.getElementById('wish-modal');
  const modalBackdrop = document.getElementById('wish-modal-backdrop');
  const modalTitle = document.getElementById('modal-title');
  const modalStats = document.getElementById('modal-stats');
  const modalBody = document.getElementById('modal-body');
  const modalClose = document.getElementById('modal-close');
  const modalVoteBtn = document.getElementById('modal-vote-btn');
  const modalVoteText = document.getElementById('modal-vote-text');

  let currentUserId: string | null = null;
  let currentModalGroup: any = null;

  type WishGroup = {
    app_name: string;
    app_name_normalized: string;
    descriptions: { description: string; display_name: string | null; created_at: string }[];
    vote_count: number;
    submission_count: number;
    has_voted: boolean;
  };

  function normalize(name: string): string {
    return name.trim().toLowerCase().replace(/\s+/g, '-');
  }

  const colors = [
    { bg: 'bg-purple-100', text: 'text-purple-800', hover: 'hover:bg-purple-200', ring: 'ring-purple-400' },
    { bg: 'bg-blue-100', text: 'text-blue-800', hover: 'hover:bg-blue-200', ring: 'ring-blue-400' },
    { bg: 'bg-green-100', text: 'text-green-800', hover: 'hover:bg-green-200', ring: 'ring-green-400' },
    { bg: 'bg-amber-100', text: 'text-amber-800', hover: 'hover:bg-amber-200', ring: 'ring-amber-400' },
    { bg: 'bg-rose-100', text: 'text-rose-800', hover: 'hover:bg-rose-200', ring: 'ring-rose-400' },
    { bg: 'bg-cyan-100', text: 'text-cyan-800', hover: 'hover:bg-cyan-200', ring: 'ring-cyan-400' },
    { bg: 'bg-indigo-100', text: 'text-indigo-800', hover: 'hover:bg-indigo-200', ring: 'ring-indigo-400' },
    { bg: 'bg-teal-100', text: 'text-teal-800', hover: 'hover:bg-teal-200', ring: 'ring-teal-400' },
  ];

  function getSize(total: number): string {
    if (total >= 20) return 'text-3xl sm:text-4xl px-6 py-3.5 font-bold';
    if (total >= 10) return 'text-2xl sm:text-3xl px-5 py-3 font-bold';
    if (total >= 5) return 'text-xl sm:text-2xl px-5 py-2.5 font-semibold';
    if (total >= 3) return 'text-lg sm:text-xl px-4 py-2 font-semibold';
    if (total >= 2) return 'text-base sm:text-lg px-4 py-2 font-medium';
    return 'text-sm sm:text-base px-3 py-1.5 font-medium';
  }

  function openModal(group: WishGroup) {
    currentModalGroup = group;
    if (modalTitle) modalTitle.textContent = group.app_name;
    if (modalStats) modalStats.textContent = `${group.vote_count} votes · ${group.submission_count} description${group.submission_count > 1 ? 's' : ''}`;

    modalBody!.innerHTML = '';
    group.descriptions.forEach((d) => {
      const card = document.createElement('div');
      card.className = 'p-4 rounded-xl bg-[var(--color-bg-secondary)] border border-[var(--color-border)]';
      const date = new Date(d.created_at).toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
      card.innerHTML = `
        <p class="text-sm text-[var(--color-text-secondary)] leading-relaxed">${d.description}</p>
        <div class="flex items-center gap-2 mt-3 text-xs text-[var(--color-text-muted)]">
          <span>${d.display_name || 'Anonymous'}</span>
          <span>·</span>
          <span>${date}</span>
        </div>
      `;
      modalBody!.appendChild(card);
    });

    updateModalVoteBtn(group.has_voted);
    modal?.classList.remove('hidden');
    document.body.style.overflow = 'hidden';
  }

  function closeModal() {
    modal?.classList.add('hidden');
    document.body.style.overflow = '';
    currentModalGroup = null;
  }

  function updateModalVoteBtn(hasVoted: boolean) {
    if (hasVoted) {
      modalVoteBtn?.classList.add('bg-[var(--color-accent)]');
      if (modalVoteText) modalVoteText.textContent = 'Voted';
    } else {
      modalVoteBtn?.classList.remove('bg-[var(--color-accent)]');
      if (modalVoteText) modalVoteText.textContent = 'Vote';
    }
  }

  modalClose?.addEventListener('click', closeModal);
  modalBackdrop?.addEventListener('click', closeModal);

  modalVoteBtn?.addEventListener('click', async () => {
    if (!currentUserId) {
      await supabase.auth.signInWithOAuth({
        provider: 'google',
        options: { redirectTo: `${window.location.origin}/auth/callback/` },
      });
      return;
    }
    if (!currentModalGroup) return;

    const norm = currentModalGroup.app_name_normalized;
    if (currentModalGroup.has_voted) {
      await supabase.from('feature_votes').delete().eq('app_name_normalized', norm).eq('user_id', currentUserId);
    } else {
      await supabase.from('feature_votes').insert({ app_name_normalized: norm, user_id: currentUserId });
    }
    closeModal();
    await loadWishes();
  });

  function createBubble(group: WishGroup, index: number) {
    const el = document.createElement('button');
    const c = colors[index % colors.length];
    const sizeClass = getSize(group.vote_count + group.submission_count);

    el.className = `inline-flex items-center gap-2 rounded-full transition-all duration-200 cursor-pointer ${sizeClass} ${c.bg} ${c.text} ${c.hover} ${group.has_voted ? `ring-2 ring-offset-1 ${c.ring}` : ''}`;
    el.innerHTML = `
      <span>${group.app_name}</span>
      <span class="opacity-50 text-[0.65em]">${group.vote_count}</span>
    `;
    el.title = `${group.submission_count} description(s) · Click to view`;
    el.addEventListener('click', () => openModal(group));
    return el;
  }

  async function loadWishes() {
    const { data: requests } = await supabase
      .from('feature_requests')
      .select('id, user_id, app_name, app_name_normalized, description, created_at, profiles(display_name)');

    const { data: allVotes } = await supabase
      .from('feature_votes')
      .select('app_name_normalized, user_id');

    const reqs = requests || [];
    const votes = allVotes || [];

    // Group by normalized name
    const groupMap = new Map<string, WishGroup>();

    reqs.forEach((r: any) => {
      const norm = r.app_name_normalized;
      if (!groupMap.has(norm)) {
        groupMap.set(norm, {
          app_name: r.app_name,
          app_name_normalized: norm,
          descriptions: [],
          vote_count: 0,
          submission_count: 0,
          has_voted: false,
        });
      }
      const g = groupMap.get(norm)!;
      g.descriptions.push({
        description: r.description,
        display_name: r.profiles?.display_name || null,
        created_at: r.created_at,
      });
      g.submission_count++;
    });

    votes.forEach((v: any) => {
      const g = groupMap.get(v.app_name_normalized);
      if (g) {
        g.vote_count++;
        if (currentUserId && v.user_id === currentUserId) g.has_voted = true;
      }
    });

    const groups = Array.from(groupMap.values()).sort(
      (a, b) => (b.vote_count + b.submission_count) - (a.vote_count + a.submission_count)
    );

    wishLoading?.classList.add('hidden');

    if (groups.length === 0) {
      wishEmpty?.classList.remove('hidden');
      wishWall?.classList.add('hidden');
      return;
    }

    wishEmpty?.classList.add('hidden');
    wishWall?.classList.remove('hidden');
    wishWall!.innerHTML = '';
    groups.forEach((g, i) => wishWall!.appendChild(createBubble(g, i)));
  }

  async function updateRemaining() {
    if (!currentUserId) return;
    const { count } = await supabase
      .from('feature_requests')
      .select('id', { count: 'exact', head: true })
      .eq('user_id', currentUserId);
    const remaining = MAX_WISHES - (count || 0);
    if (wishRemaining) wishRemaining.textContent = `${remaining} wish${remaining !== 1 ? 'es' : ''} remaining`;
    if (remaining <= 0) {
      submitBtn?.setAttribute('disabled', 'true');
      submitBtn?.classList.add('opacity-50');
    } else {
      submitBtn?.removeAttribute('disabled');
      submitBtn?.classList.remove('opacity-50');
    }
  }

  async function init() {
    const { data: { session } } = await supabase.auth.getSession();
    currentUserId = session?.user?.id || null;

    if (currentUserId) {
      submitForm?.classList.remove('hidden');
      loginPrompt?.classList.add('hidden');
      await updateRemaining();
    } else {
      submitForm?.classList.add('hidden');
      loginPrompt?.classList.remove('hidden');
    }

    await loadWishes();
  }

  loginBtn?.addEventListener('click', async () => {
    await supabase.auth.signInWithOAuth({
      provider: 'google',
      options: { redirectTo: `${window.location.origin}/auth/callback/` },
    });
  });

  submitBtn?.addEventListener('click', async () => {
    const appName = nameInput?.value.trim();
    const desc = descInput?.value.trim();

    wishError?.classList.add('hidden');

    if (!appName) {
      wishError!.textContent = 'Please enter an app name (1–3 words).';
      wishError?.classList.remove('hidden');
      return;
    }

    const wordCount = appName.split(/\s+/).length;
    if (wordCount > 3) {
      wishError!.textContent = 'App name should be 1–3 words.';
      wishError?.classList.remove('hidden');
      return;
    }

    if (!desc) {
      wishError!.textContent = 'Please describe what the app should do.';
      wishError?.classList.remove('hidden');
      return;
    }

    if (!currentUserId) return;

    submitBtn!.setAttribute('disabled', 'true');

    const { count } = await supabase
      .from('feature_requests')
      .select('id', { count: 'exact', head: true })
      .eq('user_id', currentUserId);

    if ((count || 0) >= MAX_WISHES) {
      wishError!.textContent = `You've reached the limit of ${MAX_WISHES} wishes.`;
      wishError?.classList.remove('hidden');
      submitBtn!.removeAttribute('disabled');
      return;
    }

    const norm = normalize(appName);

    const { error } = await supabase.from('feature_requests').insert({
      user_id: currentUserId,
      app_name: appName,
      app_name_normalized: norm,
      description: desc,
    });

    if (error) {
      wishError!.textContent = 'Failed to submit. Please try again.';
      wishError?.classList.remove('hidden');
      submitBtn!.removeAttribute('disabled');
      return;
    }

    // Auto-vote for own wish
    await supabase.from('feature_votes').upsert(
      { app_name_normalized: norm, user_id: currentUserId },
      { onConflict: 'app_name_normalized,user_id' }
    );

    nameInput!.value = '';
    descInput!.value = '';
    submitBtn!.removeAttribute('disabled');
    await updateRemaining();
    await loadWishes();
  });

  nameInput?.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') descInput?.focus();
  });
  descInput?.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') submitBtn?.click();
  });

  init();
</script>
