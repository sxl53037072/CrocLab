---
import BaseLayout from '../../layouts/BaseLayout.astro';
import type { Lang } from '../../i18n/translations';

const lang: Lang = 'zh';
---

<BaseLayout
  title="个人中心 — CrocLab"
  description="你在 CrocLab 的个人中心页面。"
  lang={lang}
  noindex={true}
>
  <section class="pt-28 pb-24">
    <div class="mx-auto max-w-4xl px-6 lg:px-8">

      <!-- Not logged in -->
      <div id="profile-login" class="hidden text-center py-20">
        <div class="w-20 h-20 rounded-2xl bg-[var(--color-bg-tertiary)] flex items-center justify-center mx-auto mb-6">
          <svg class="w-10 h-10 text-[var(--color-text-muted)]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
          </svg>
        </div>
        <h1 class="font-display text-2xl font-bold text-[var(--color-text)] mb-3">登录以查看你的个人中心</h1>
        <p class="text-[var(--color-text-secondary)] mb-6">访问你的收藏和浏览历史。</p>
        <button id="profile-login-btn" class="btn-primary">
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
            <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 01-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z" fill="#4285F4"/>
            <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
            <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/>
            <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
          </svg>
          使用 Google 登录
        </button>
      </div>

      <!-- Profile content -->
      <div id="profile-content" class="hidden">
        <!-- User header -->
        <div class="flex items-center gap-5 mb-10">
          <img id="profile-avatar" src="" alt="头像" class="w-20 h-20 rounded-2xl border-2 border-[var(--color-border)] object-cover shadow-sm" />
          <div>
            <h1 id="profile-name" class="font-display text-2xl font-bold text-[var(--color-text)]"></h1>
            <p id="profile-email" class="text-sm text-[var(--color-text-muted)]"></p>
          </div>
        </div>

        <!-- Tabs -->
        <div class="flex gap-1 mb-8 border-b border-[var(--color-border)]">
          <button id="tab-favorites" class="px-5 py-3 text-sm font-medium text-[var(--color-accent)] border-b-2 border-[var(--color-accent)] transition-colors" data-tab="favorites">
            收藏
          </button>
          <button id="tab-history" class="px-5 py-3 text-sm font-medium text-[var(--color-text-muted)] border-b-2 border-transparent hover:text-[var(--color-text)] transition-colors" data-tab="history">
            浏览历史
          </button>
        </div>

        <!-- Favorites Tab -->
        <div id="panel-favorites">
          <div id="fav-loading" class="text-center py-12">
            <div class="inline-block w-6 h-6 border-2 border-[var(--color-border)] border-t-[var(--color-text)] rounded-full animate-spin"></div>
          </div>
          <div id="fav-empty" class="hidden text-center py-12">
            <div class="w-14 h-14 rounded-2xl bg-[rgba(244,63,94,0.1)] flex items-center justify-center mx-auto mb-4">
              <svg class="w-7 h-7 text-rose-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
              </svg>
            </div>
            <p class="text-[var(--color-text-secondary)]">还没有收藏。开始收集你喜欢的文章吧！</p>
          </div>
          <div id="fav-list" class="hidden space-y-3"></div>
        </div>

        <!-- History Tab -->
        <div id="panel-history" class="hidden">
          <div id="hist-loading" class="text-center py-12">
            <div class="inline-block w-6 h-6 border-2 border-[var(--color-border)] border-t-[var(--color-text)] rounded-full animate-spin"></div>
          </div>
          <div id="hist-empty" class="hidden text-center py-12">
            <div class="w-14 h-14 rounded-2xl bg-[rgba(59,130,246,0.1)] flex items-center justify-center mx-auto mb-4">
              <svg class="w-7 h-7 text-blue-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
            <p class="text-[var(--color-text-secondary)]">还没有浏览记录。开始探索吧！</p>
          </div>
          <div id="hist-list" class="hidden space-y-3"></div>
        </div>
      </div>

    </div>
  </section>
</BaseLayout>

<script>
  import { createClient } from '@supabase/supabase-js';

  const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL;
  const supabaseAnonKey = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;
  const supabase = createClient(supabaseUrl, supabaseAnonKey);

  const loginSection = document.getElementById('profile-login');
  const contentSection = document.getElementById('profile-content');
  const loginBtn = document.getElementById('profile-login-btn');

  const avatar = document.getElementById('profile-avatar') as HTMLImageElement;
  const nameEl = document.getElementById('profile-name');
  const emailEl = document.getElementById('profile-email');

  const tabFav = document.getElementById('tab-favorites');
  const tabHist = document.getElementById('tab-history');
  const panelFav = document.getElementById('panel-favorites');
  const panelHist = document.getElementById('panel-history');

  function switchTab(tab: string) {
    const isF = tab === 'favorites';
    tabFav?.classList.toggle('text-[var(--color-accent)]', isF);
    tabFav?.classList.toggle('border-[var(--color-accent)]', isF);
    tabFav?.classList.toggle('text-[var(--color-text-muted)]', !isF);
    tabFav?.classList.toggle('border-transparent', !isF);
    tabHist?.classList.toggle('text-[var(--color-accent)]', !isF);
    tabHist?.classList.toggle('border-[var(--color-accent)]', !isF);
    tabHist?.classList.toggle('text-[var(--color-text-muted)]', isF);
    tabHist?.classList.toggle('border-transparent', isF);
    panelFav?.classList.toggle('hidden', !isF);
    panelHist?.classList.toggle('hidden', isF);
  }

  tabFav?.addEventListener('click', () => switchTab('favorites'));
  tabHist?.addEventListener('click', () => switchTab('history'));

  function formatDate(dateStr: string): string {
    return new Date(dateStr).toLocaleDateString('zh-CN', { month: 'long', day: 'numeric', year: 'numeric' });
  }

  async function loadFavorites(userId: string) {
    const favLoading = document.getElementById('fav-loading');
    const favEmpty = document.getElementById('fav-empty');
    const favList = document.getElementById('fav-list');

    const { data, error } = await supabase
      .from('favorites')
      .select('*')
      .eq('user_id', userId)
      .order('created_at', { ascending: false });

    favLoading?.classList.add('hidden');

    if (error || !data || data.length === 0) {
      favEmpty?.classList.remove('hidden');
      return;
    }

    favList?.classList.remove('hidden');
    favList!.innerHTML = '';

    data.forEach((fav: any) => {
      const blogPath = fav.article_lang === 'zh' ? `/zh/blog/${fav.article_slug}/` : `/blog/${fav.article_slug}/`;
      const el = document.createElement('a');
      el.href = blogPath;
      el.className = 'flex items-center justify-between p-4 rounded-xl border border-[var(--color-border)] hover:border-[var(--color-accent)]/30 hover:bg-[var(--color-accent-soft)]/50 transition-all group';
      el.innerHTML = `
        <div class="flex items-center gap-3 min-w-0">
          <svg class="w-4 h-4 text-[var(--color-accent)] shrink-0" fill="currentColor" viewBox="0 0 24 24">
            <path d="M11.645 20.91l-.007-.003-.022-.012a15.247 15.247 0 01-.383-.218 25.18 25.18 0 01-4.244-3.17C4.688 15.36 2.25 12.174 2.25 8.25 2.25 5.322 4.714 3 7.688 3A5.5 5.5 0 0112 5.052 5.5 5.5 0 0116.313 3c2.973 0 5.437 2.322 5.437 5.25 0 3.925-2.438 7.111-4.739 9.256a25.175 25.175 0 01-4.244 3.17 15.247 15.247 0 01-.383.219l-.022.012-.007.004-.003.001a.752.752 0 01-.704 0l-.003-.001z" />
          </svg>
          <span class="text-sm font-medium text-[var(--color-text)] truncate group-hover:text-[var(--color-accent)] transition-colors">${fav.article_title || fav.article_slug}</span>
        </div>
        <span class="text-xs text-[var(--color-text-muted)] shrink-0 ml-4">${formatDate(fav.created_at)}</span>
      `;
      favList!.appendChild(el);
    });
  }

  async function loadHistory(userId: string) {
    const histLoading = document.getElementById('hist-loading');
    const histEmpty = document.getElementById('hist-empty');
    const histList = document.getElementById('hist-list');

    const { data, error } = await supabase
      .from('visit_history')
      .select('*')
      .eq('user_id', userId)
      .order('visited_at', { ascending: false })
      .limit(50);

    histLoading?.classList.add('hidden');

    if (error || !data || data.length === 0) {
      histEmpty?.classList.remove('hidden');
      return;
    }

    histList?.classList.remove('hidden');
    histList!.innerHTML = '';

    data.forEach((visit: any) => {
      const el = document.createElement('a');
      el.href = visit.page_path;
      el.className = 'flex items-center justify-between p-4 rounded-xl border border-[var(--color-border)] hover:border-[var(--color-border-light)] hover:bg-[var(--color-bg-secondary)] transition-all group';
      el.innerHTML = `
        <div class="flex items-center gap-3 min-w-0">
          <svg class="w-4 h-4 text-blue-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <span class="text-sm font-medium text-[var(--color-text)] truncate group-hover:text-blue-600 transition-colors">${visit.page_title || visit.page_path}</span>
        </div>
        <span class="text-xs text-[var(--color-text-muted)] shrink-0 ml-4">${formatDate(visit.visited_at)}</span>
      `;
      histList!.appendChild(el);
    });
  }

  async function init() {
    const { data: { session } } = await supabase.auth.getSession();

    if (!session?.user) {
      loginSection?.classList.remove('hidden');
      contentSection?.classList.add('hidden');
      return;
    }

    loginSection?.classList.add('hidden');
    contentSection?.classList.remove('hidden');

    const user = session.user;
    if (avatar) avatar.src = user.user_metadata?.avatar_url || user.user_metadata?.picture || '';
    if (nameEl) nameEl.textContent = user.user_metadata?.full_name || user.user_metadata?.name || 'User';
    if (emailEl) emailEl.textContent = user.email || '';

    await Promise.all([loadFavorites(user.id), loadHistory(user.id)]);
  }

  loginBtn?.addEventListener('click', async () => {
    await supabase.auth.signInWithOAuth({
      provider: 'google',
      options: { redirectTo: `${window.location.origin}/auth/callback/` },
    });
  });

  init();
</script>
