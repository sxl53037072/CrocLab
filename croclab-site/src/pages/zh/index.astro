---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductCard from '../../components/ProductCard.astro';
import BlogCard from '../../components/BlogCard.astro';
import { products, getAppProducts, getExtensionProducts } from '../../data/products';
import { useTranslation } from '../../i18n/translations';
import { getCollection } from 'astro:content';
import type { Lang } from '../../i18n/translations';

const lang: Lang = 'zh';
const t = useTranslation(lang);
const apps = getAppProducts();
const extensions = getExtensionProducts();

const allPosts = await getCollection('blog-zh');
const blogPosts = allPosts
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3)
  .map((post) => ({
    title: post.data.title,
    description: post.data.description,
    slug: post.slug,
    date: post.data.date.toISOString().split('T')[0],
    readTime: post.data.readTime,
    tag: post.data.tag,
  }));
---

<BaseLayout title="CrocLab — 打造让数字生活更简单的工具" description="CrocLab 是一个创意技术工作室，专注打造高品质的应用和浏览器扩展。" lang={lang}>
  <section class="hero-section relative min-h-[90vh] flex items-center overflow-hidden pt-16">
    <!-- Hero Carousel -->
    <div class="hero-carousel" id="hero-carousel">
      <div class="hero-slide active">
        <img src="/images/blog/office-hero.webp" alt="创意工作空间" loading="eager" fetchpriority="high" />
      </div>
      <div class="hero-slide">
        <img src="/images/blog/hero-night-sky.webp" alt="夜空星辰 — DreamTone 助你安睡" loading="lazy" />
      </div>
      <div class="hero-slide">
        <img src="/images/blog/hero-focus-desk.webp" alt="专注工作台 — FocusCroc 提升效率" loading="lazy" />
      </div>
      <div class="hero-slide">
        <img src="/images/blog/hero-phone-camera.webp" alt="手机摄影 — IDSnap 证件照" loading="lazy" />
      </div>
      <div class="hero-slide">
        <img src="/images/blog/hero-tech-workspace.webp" alt="科技工作台 — CrocLab 开发者工具" loading="lazy" />
      </div>
      <div class="absolute inset-0 hero-overlay-h" style="z-index: 2"></div>
      <div class="absolute inset-0 hero-overlay-v" style="z-index: 2"></div>

      <div class="carousel-dots" id="carousel-dots">
        <button class="carousel-dot active" data-index="0"></button>
        <button class="carousel-dot" data-index="1"></button>
        <button class="carousel-dot" data-index="2"></button>
        <button class="carousel-dot" data-index="3"></button>
        <button class="carousel-dot" data-index="4"></button>
      </div>
    </div>

    <!-- Floating decorative blobs -->
    <div class="blob w-96 h-96 bg-[var(--color-accent)] top-10 right-[10%] float-slow"></div>
    <div class="blob w-72 h-72 bg-purple-500 bottom-20 left-[5%] float-medium" style="animation-delay: -3s"></div>
    <div class="blob w-56 h-56 bg-blue-500 top-[35%] right-[35%] float-slow" style="animation-delay: -5s"></div>

    <div class="relative z-10 mx-auto max-w-7xl px-6 lg:px-8 w-full">
      <div class="max-w-2xl">
        <div class="hero-badge inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-[var(--color-bg-tertiary)] border border-[var(--color-border)] mb-8">
          <span class="w-2 h-2 rounded-full bg-green-500 animate-pulse"></span>
          <span class="text-xs font-medium text-[var(--color-text-secondary)]">{t('hero.tagline')}</span>
        </div>
        <h1 class="hero-title font-display text-4xl sm:text-5xl lg:text-6xl font-bold leading-[1.1] tracking-tight mb-6 text-[var(--color-text)]">
          <span id="hero-typed-zh"></span><span class="typing-cursor" id="hero-cursor-zh"></span>
          <span class="gradient-text">更简单</span>的工具。
        </h1>
        <p class="hero-subtitle max-w-xl text-lg text-[var(--color-text-secondary)] leading-relaxed mb-10">{t('hero.description')}</p>
        <div class="hero-cta-row flex flex-col sm:flex-row items-start gap-4">
          <a href="#products" class="btn-primary group">{t('hero.cta')}<svg class="w-4 h-4 transition-transform group-hover:translate-y-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" /></svg></a>
          <a href="/zh/about/" class="btn-secondary group">{t('nav.about')}<svg class="w-4 h-4 transition-transform group-hover:translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg></a>
        </div>
        <div class="hero-icons-row mt-14 flex items-center gap-6">
          <div class="flex -space-x-2">
            {products.map((p) => (<img src={p.icon} alt={p.name} class="product-mini-icon w-14 h-14 rounded-2xl border-2 border-[var(--color-bg)] shadow-md transition-transform hover:scale-110 hover:-translate-y-1" />))}
          </div>
          <div class="hero-icons-stats">
            <div class="text-sm font-semibold text-[var(--color-text)]"><span class="count-up" data-target={products.length}>0</span> 款产品</div>
            <div class="text-xs text-[var(--color-text-muted)]">应用 & 浏览器扩展</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="products" class="products-section py-24 lg:py-32 bg-[var(--color-bg-secondary)]">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <div class="products-header text-center mb-16">
        <p class="section-eyebrow text-sm font-semibold uppercase tracking-widest text-[var(--color-accent)] mb-3">{t('products.apps')}</p>
        <h2 class="section-title font-display text-3xl sm:text-4xl font-bold text-[var(--color-text)] mb-4">{t('products.title')}</h2>
        <p class="section-sub mx-auto max-w-xl text-[var(--color-text-secondary)]">{t('products.subtitle')}</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8 mb-24">
        {apps.map((p, i) => (<ProductCard product={p} lang={lang} index={i} pinReveal />))}
      </div>
      <div id="extensions" class="products-extensions-block">
        <div class="products-extensions-header text-center mb-16">
          <p class="section-eyebrow text-sm font-semibold uppercase tracking-widest text-emerald-600 mb-3">{t('products.extensions')}</p>
          <h2 class="section-title font-display text-3xl sm:text-4xl font-bold text-[var(--color-text)] mb-4">浏览器扩展</h2>
          <p class="section-sub mx-auto max-w-xl text-[var(--color-text-secondary)]">增强日常工作流程的强大浏览器工具。</p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8">
          {extensions.map((p, i) => (<ProductCard product={p} lang={lang} index={i + apps.length} pinReveal />))}
        </div>
      </div>
    </div>
  </section>

  <div class="section-divider mx-auto max-w-7xl"></div>

  <section class="py-24 lg:py-32">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <div class="flex flex-col sm:flex-row items-start sm:items-end justify-between gap-4 mb-12">
        <div>
          <p class="section-eyebrow text-sm font-semibold uppercase tracking-widest text-purple-600 mb-3">{t('nav.blog')}</p>
          <h2 class="section-title font-display text-3xl sm:text-4xl font-bold text-[var(--color-text)]">{t('blog.title')}</h2>
          <p class="section-sub mt-2 text-[var(--color-text-secondary)] max-w-lg">{t('blog.subtitle')}</p>
        </div>
        <a href="/zh/blog/" class="btn-secondary text-sm shrink-0">{t('blog.viewAll')}<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg></a>
      </div>
      <div class="blog-posts-grid grid grid-cols-1 md:grid-cols-3 gap-6">
        {blogPosts.map((post, i) => (<BlogCard {...post} lang={lang} index={i} />))}
      </div>
    </div>
  </section>

  <section class="cta-section py-24 lg:py-32 bg-[var(--color-cta-bg)] relative overflow-hidden">
    <div class="cta-spotlight" aria-hidden="true"></div>
    <div class="cta-spotlight cta-spotlight-secondary" aria-hidden="true"></div>
    <div class="absolute inset-0 opacity-10"><img src="/images/blog/team-working.webp" alt="团队协作" class="cta-bg-image w-full h-full object-cover" loading="lazy" /></div>
    <div class="relative z-10 mx-auto max-w-4xl px-6 text-center">
      <img src="/images/logo/croclab-logo.webp" alt="CrocLab" class="cta-logo w-16 h-16 rounded-2xl mx-auto mb-6 shadow-lg" width="64" height="64" />
      <h2 class="cta-title font-display text-3xl sm:text-4xl font-bold text-white mb-4">准备好提升你的效率了吗？</h2>
      <p class="cta-sub mx-auto max-w-xl text-white/70 mb-8">探索我们的产品，找到适合你工作流程的完美工具。</p>
      <div class="cta-actions flex flex-col sm:flex-row items-center justify-center gap-4">
        <a href="#products" class="cta-btn-primary inline-flex items-center gap-2 px-6 py-3 rounded-xl font-semibold text-sm bg-white text-[#1a1a2e]">{t('hero.cta')}</a>
        <a href="/zh/contact/" class="cta-btn-secondary inline-flex items-center gap-2 px-6 py-3 rounded-xl font-semibold text-sm text-white border border-white/30">{t('nav.contact')}</a>
      </div>
    </div>
  </section>

  <script>
    import '../../scripts/home-animations';
  </script>
</BaseLayout>
