---
import SEOHead from '../components/SEOHead.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import CookieConsent from '../components/CookieConsent.astro';
import type { Lang } from '../i18n/translations';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  lang?: Lang;
  ogImage?: string;
  schema?: Record<string, unknown> | Record<string, unknown>[];
  noindex?: boolean;
}

const {
  title,
  description,
  lang = 'en',
  ogImage,
  schema,
  noindex,
} = Astro.props;

const pathname = Astro.url.pathname;
const siteUrl = 'https://croclab.dev';
const enPath = lang === 'zh' ? pathname.replace(/^\/zh/, '') || '/' : pathname;
const zhPath = lang === 'en'
  ? (pathname === '/' ? '/zh/' : `/zh${pathname.endsWith('/') ? pathname : `${pathname}/`}`)
  : pathname;
---

<!DOCTYPE html>
<html lang={lang} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script is:inline>
      (function() {
        var theme = localStorage.getItem('theme') || 'dark';
        if (theme === 'dark') {
          document.documentElement.setAttribute('data-theme', 'dark');
          document.documentElement.classList.add('dark');
        }
      })();
    </script>
    <link rel="icon" type="image/png" sizes="180x180" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="dns-prefetch" href="https://fonts.googleapis.com" />
    <link rel="alternate" hreflang="en" href={`${siteUrl}${enPath}`} />
    <link rel="alternate" hreflang="zh" href={`${siteUrl}${zhPath}`} />
    <link rel="alternate" hreflang="x-default" href={`${siteUrl}${enPath}`} />
    <meta name="generator" content={Astro.generator} />
    <SEOHead
      title={title}
      description={description}
      ogImage={ogImage}
      schema={schema}
      noindex={noindex}
    />
  </head>
  <body class="min-h-screen flex flex-col bg-[var(--color-bg)]">
    <Nav lang={lang} currentPath={Astro.url.pathname} />
    <main class="flex-1">
      <slot />
    </main>
    <Footer lang={lang} />
    <CookieConsent lang={lang} />

    <script>
      /* --- Scroll reveal observer (handles animate-on-scroll, reveal-left, reveal-right) --- */
      const revealObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('visible');
            }
          });
        },
        { threshold: 0.1, rootMargin: '0px 0px -50px 0px' }
      );
      document.querySelectorAll('.animate-on-scroll, .reveal-left, .reveal-right').forEach((el) => {
        revealObserver.observe(el);
      });

      /* --- Typewriter for hero heading --- */
      function startTyping(elId: string, cursorId: string, text: string, speed: number) {
        const el = document.getElementById(elId);
        const cursor = document.getElementById(cursorId);
        if (!el) return;
        let i = 0;
        function typeChar() {
          if (i < text.length) {
            el!.textContent += text.charAt(i);
            i++;
            setTimeout(typeChar, speed + Math.random() * (speed * 0.6));
          } else if (cursor) {
            setTimeout(() => cursor.style.display = 'none', 2000);
          }
        }
        setTimeout(typeChar, 600);
      }
      startTyping('hero-typed', 'hero-cursor', 'Crafting tools that make your digital life', 35);
      startTyping('hero-typed-zh', 'hero-cursor-zh', '打造让数字生活', 80);

      /* --- Count-up animation --- */
      const countObserver = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          const el = entry.target as HTMLElement;
          const target = parseInt(el.dataset.target || '0', 10);
          const duration = 1200;
          const start = performance.now();
          function step(now: number) {
            const elapsed = now - start;
            const progress = Math.min(elapsed / duration, 1);
            const eased = 1 - Math.pow(1 - progress, 3);
            el.textContent = String(Math.round(eased * target));
            if (progress < 1) requestAnimationFrame(step);
          }
          requestAnimationFrame(step);
          countObserver.unobserve(el);
        });
      }, { threshold: 0.5 });
      document.querySelectorAll('.count-up').forEach((el) => countObserver.observe(el));

      /* --- Card glow follow mouse --- */
      document.querySelectorAll<HTMLElement>('.card-glow').forEach((card) => {
        card.addEventListener('mousemove', (e) => {
          const rect = card.getBoundingClientRect();
          card.style.setProperty('--mouse-x', (e.clientX - rect.left) + 'px');
          card.style.setProperty('--mouse-y', (e.clientY - rect.top) + 'px');
        });
      });

      /* --- 3D tilt effect on BlogCards (stronger) --- */
      document.querySelectorAll<HTMLElement>('.tilt-card').forEach((card) => {
        card.addEventListener('mousemove', (e) => {
          const rect = card.getBoundingClientRect();
          const x = (e.clientX - rect.left) / rect.width - 0.5;
          const y = (e.clientY - rect.top) / rect.height - 0.5;
          card.style.transform = `perspective(600px) rotateY(${x * 14}deg) rotateX(${-y * 14}deg) translateY(-6px) scale(1.02)`;
        });
        card.addEventListener('mouseleave', () => {
          card.style.transform = '';
        });
      });

      /* --- Hero Carousel --- */
      const carousel = document.getElementById('hero-carousel');
      if (carousel) {
        const slides = carousel.querySelectorAll<HTMLElement>('.hero-slide');
        const dots = carousel.querySelectorAll<HTMLElement>('.carousel-dot');
        let current = 0;
        let timer: ReturnType<typeof setInterval>;

        function showSlide(idx: number) {
          slides.forEach((s, i) => s.classList.toggle('active', i === idx));
          dots.forEach((d, i) => d.classList.toggle('active', i === idx));
          current = idx;
        }

        function nextSlide() {
          showSlide((current + 1) % slides.length);
        }

        timer = setInterval(nextSlide, 5000);

        dots.forEach((dot) => {
          dot.addEventListener('click', () => {
            clearInterval(timer);
            showSlide(parseInt(dot.dataset.index || '0', 10));
            timer = setInterval(nextSlide, 5000);
          });
        });
      }

      /* --- Prose content animations (blog articles) --- */
      const proseEl = document.querySelector('.prose');
      if (proseEl) {
        const proseObserver = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('prose-visible');
            }
          });
        }, { threshold: 0.15, rootMargin: '0px 0px -30px 0px' });

        proseEl.querySelectorAll('h2, h3, p, ul, ol, blockquote, img').forEach((el) => {
          proseObserver.observe(el);
        });
      }
    </script>

    <!-- Theme toggle -->
    <script is:inline>
      (function() {
        function getTheme() {
          return localStorage.getItem('theme') || 'dark';
        }

        function applyTheme(theme) {
          var root = document.documentElement;
          var suns = document.querySelectorAll('.theme-icon-sun');
          var moons = document.querySelectorAll('.theme-icon-moon');

          if (theme === 'dark') {
            root.setAttribute('data-theme', 'dark');
            root.classList.add('dark');
            suns.forEach(function(el) { el.classList.remove('hidden'); });
            moons.forEach(function(el) { el.classList.add('hidden'); });
          } else {
            root.removeAttribute('data-theme');
            root.classList.remove('dark');
            suns.forEach(function(el) { el.classList.add('hidden'); });
            moons.forEach(function(el) { el.classList.remove('hidden'); });
          }
        }

        applyTheme(getTheme());

        document.querySelectorAll('.theme-toggle').forEach(function(btn) {
          btn.addEventListener('click', function() {
            var next = getTheme() === 'dark' ? 'light' : 'dark';
            localStorage.setItem('theme', next);
            applyTheme(next);
          });
        });

        window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', function(e) {
          if (!localStorage.getItem('theme')) {
            applyTheme(e.matches ? 'dark' : 'light');
          }
        });
      })();
    </script>

    <!-- Visit history tracking -->
    <script>
      import { createClient } from '@supabase/supabase-js';

      const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL;
      const supabaseAnonKey = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;

      if (supabaseUrl && supabaseAnonKey) {
        const supabase = createClient(supabaseUrl, supabaseAnonKey);

        async function trackVisit() {
          const { data: { session } } = await supabase.auth.getSession();
          if (!session?.user) return;

          const path = window.location.pathname;
          const skipPaths = ['/auth/', '/profile/'];
          if (skipPaths.some(p => path.includes(p))) return;

          const title = document.title.split(' — ')[0] || document.title;

          await supabase.from('visit_history').insert({
            user_id: session.user.id,
            page_path: path,
            page_title: title,
          });
        }

        trackVisit();
      }
    </script>
  </body>
</html>
